# SmartService environment-variable names and safe defaults only.
# Copy to .env.local for local development. Never commit real values.

# Public browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
VITE_LIVEKIT_URL=
VITE_TURNSTILE_SITE_KEY=
VITE_DEMO_PUBLIC_KEY=smart-service-public-demo

# HelloX Feedback browser-safe configuration and server-only identity key
HELLOX_FEEDBACK_INSTALLATION_KEY=
HELLOX_FEEDBACK_TURNSTILE_SITE_KEY=
HELLOX_FEEDBACK_SERVER_KEY=

# Supabase server and CLI configuration
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DATABASE_URL=

# OpenAI server configuration
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_SUPERVISOR_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024

# Primary hosted chat inference and OpenAI reliability fallback
CHAT_PRIMARY_PROVIDER=openai
WORKERS_AI_GATEWAY_ID=default

# Cloudflare deployment, R2 signing, and Browser Run access
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_BROWSER_RUN_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
CONVERSATION_TOKEN_SECRET=
CONVERSATION_TOKEN_TTL_MINUTES=120

# Cloudflare resource and binding names
R2_BUCKET_NAME=smartservice-knowledge-dev
R2_BUCKET_BINDING=KNOWLEDGE_FILES
INGEST_QUEUE_NAME=smartservice-ingest-dev
INGEST_QUEUE_BINDING=INGEST_QUEUE
INGESTION_PROVIDER_MODE=mock
UPLOAD_PROVIDER_MODE=mock
CRAWL_PROVIDER_MODE=mock
EMBEDDING_PROVIDER_MODE=mock
CHAT_PROVIDER_MODE=mock
AUXILIARY_PROVIDER_MODE=mock
TURNSTILE_PROVIDER_MODE=mock
VOICE_PROVIDER_MODE=mock
RAG_MATCH_THRESHOLD=0.35
LOCAL_UPLOAD_SIGNING_SECRET=
FINALIZE_QUEUE_NAME=smartservice-finalize-dev
FINALIZE_QUEUE_BINDING=FINALIZE_QUEUE

# LiveKit voice agent
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=smartservice-voice-agent
VOICE_INTERNAL_API_BASE_URL=
VOICE_INTERNAL_SERVICE_TOKEN=

# Voice providers
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=zh-CN
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Local/demo seed identities; passwords are server-side test secrets
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_AGENT_EMAIL=
DEMO_AGENT_PASSWORD=
DEMO_OTHER_ADMIN_EMAIL=
DEMO_OTHER_ADMIN_PASSWORD=

# Safe feature defaults
ENABLE_ENGLISH=true
ENABLE_AUDIO_RECORDING=false
ENABLE_R11_TICKET_UI=false

# Optional providers; disabled unless explicitly approved
FIRECRAWL_API_KEY=
RESEND_API_KEY=
