{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smartservice-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "ENVIRONMENT": "development",
    "HELLOX_FEEDBACK_INSTALLATION_KEY": "hxf_live_e239ef638778651b5e8e479ceee42b703fbbb4370d6a1a32",
    "HELLOX_FEEDBACK_TURNSTILE_SITE_KEY": "0x4AAAAAAEDx-9ipx7TvTGQV",
    "AUXILIARY_PROVIDER_MODE": "mock",
    "CHAT_PROVIDER_MODE": "mock",
    "INGESTION_PROVIDER_MODE": "mock",
    "OPENAI_EMBEDDING_DIMENSIONS": "1024",
    "OPENAI_EMBEDDING_MODEL": "text-embedding-3-large",
    "R2_BUCKET_NAME": "smartservice-knowledge-dev",
    "TURNSTILE_PROVIDER_MODE": "mock",
    "VOICE_PROVIDER_MODE": "mock",
    "LIVEKIT_AGENT_NAME": "smartservice-voice-agent",
    "VERSION": "0.10.0",
  },
  "r2_buckets": [
    {
      "binding": "KNOWLEDGE_FILES",
      "bucket_name": "smartservice-knowledge-dev",
      "preview_bucket_name": "smartservice-knowledge-preview",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "smartservice-ingest-dev",
      },
      {
        "binding": "FINALIZE_QUEUE",
        "queue": "smartservice-finalize-dev",
      },
    ],
    "consumers": [
      {
        "queue": "smartservice-ingest-dev",
        "dead_letter_queue": "smartservice-ingest-dlq-dev",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 2,
      },
      {
        "queue": "smartservice-finalize-dev",
        "dead_letter_queue": "smartservice-finalize-dlq-dev",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 2,
      },
    ],
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/health"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
